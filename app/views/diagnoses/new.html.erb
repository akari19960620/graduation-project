<h1>診断質問</h1>

<%= form_with url: diagnoses_path, method: :post, data: { turbo: false }, id: "diagnosis-form" do |f| %>
  <% @questions.each do |question| %>
    <div class="question mb-4">
      <h2><%= question.question_text %></h2>

      <% question.diagnosis_options.order(:display_order).each do |option| %>
        <div class="option">
          <%= f.radio_button "question_#{question.id}", option.id, 
              id: "question_#{question.id}_option_#{option.id}",
              required: true %>
          <%= f.label "question_#{question.id}_option_#{option.id}", option.option_text %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= f.submit '診断結果を表示', class: 'btn btn-primary' %>
<% end %>
