<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="text-center mb-4">新規登録</h1>

      <%= form_with model: @user, url: users_path, local: true do |f| %>
        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <h2 class="h6 mb-2"><%= @user.errors.count %>件のエラーが発生しました</h2>
            <ul class="mb-0">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, "ユーザー名", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.text_field :email, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>

        <div class="actions mt-4">
          <%= f.submit "登録する", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>
</div>