<header class="bg-light border-bottom py-1">
  <div class="container d-flex justify-content-between align-items-center">
    <%= link_to "ケアバンク", root_path, class: "fw-bold fs-3 text-primary text-decoration-none" %>
    
    <div class="d-flex align-items-center gap-2">
      <% if logged_in? %>
        <span class="fw-bold"> ようこそ<%= current_user.name %> さん</span>
        <%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-outline-secondary" %>
      <% else %>
        <%= link_to "ユーザー登録", new_user_path, class: "btn btn-outline-primary" %>
        <%= link_to "ログイン", new_login_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</header>